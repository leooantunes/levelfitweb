# Quem é o controlador dos dados (LGPD). Aparece na política e no rodapé.
NEXT_PUBLIC_CONTROLLER_NAME=
# E-mail de suporte / encarregado. O mesmo de EXPO_PUBLIC_SUPPORT_EMAIL no app.
NEXT_PUBLIC_SUPPORT_EMAIL=
# URL pública do site (usada nos metadados e no canonical). Ex.: https://levelfit.app
NEXT_PUBLIC_SITE_URL=
